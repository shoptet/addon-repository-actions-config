{
  "name": "shoptet-addon-review-system",
  "version": "2.0.0",
  "description": "Automated code review system for Shoptet addons using ESLint with custom rules",
  "scripts": {
    "review": "node review.js",
    "test": "node test/selftest.js && node test/rule-equality.js && node test/conformance.js",
    "test:selftest": "node test/selftest.js",
    "test:rule-equality": "node test/rule-equality.js",
    "test:conformance": "node test/conformance.js"
  },
  "keywords": [
    "shoptet",
    "addon",
    "review",
    "eslint"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@shoptet/addon-eslint-config": "link:../packages/addon-eslint-config",
    "@shoptet/addon-html-lint": "link:../packages/addon-html-lint",
    "@shoptet/addon-lint-conformance": "link:../packages/addon-lint-conformance",
    "@shoptet/addon-stylelint-config": "link:../packages/addon-stylelint-config",
    "eslint": "^9.39.5",
    "glob": "^10.3.0",
    "postcss": "^8.4.28",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^15.11.0"
  }
}
